{% if section.settings.show %}
  <div class="announcement">{{ section.settings.text | escape }}</div>
{% endif %}
{% schema %}
{"name":"Announcement","settings":[{"type":"checkbox","id":"show","label":"Show announcement","default":true},{"type":"text","id":"text","label":"Text","default":"Free shipping on qualifying Canada & USA orders · CAD $120+"}]}
{% endschema %}
