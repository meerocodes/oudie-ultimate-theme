{% if section.settings.show %}
  <div class="announcement">{{ section.settings.text | escape }}</div>
{% endif %}
{% schema %}
{"name":"Announcement","settings":[{"type":"checkbox","id":"show","label":"Show announcement","default":true},{"type":"text","id":"text","label":"Text","default":"Free standard shipping · Canada CAD $120+ · USA CAD $162+"}]}
{% endschema %}
