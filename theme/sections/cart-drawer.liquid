<dialog class="cart-drawer" data-cart-drawer aria-labelledby="CartDrawerTitle">
  <p class="visually-hidden" data-cart-status role="status"></p>
  <p class="cart-error" data-cart-error role="alert" hidden></p>
  <div data-cart-content data-count="{{ cart.item_count }}">
    <div class="cart-drawer-head"><h2 id="CartDrawerTitle">Your bag <span>({{ cart.item_count }})</span></h2><button class="cart-close" type="button" data-cart-close aria-label="Close bag" autofocus>×</button></div>
    {% if cart.item_count == 0 %}
      <div class="empty-state"><p>Your bag is empty.</p><a class="btn" href="{{ pages['our-scents'].url | default: routes.all_products_collection_url }}">Find your scent</a></div>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post" class="cart-drawer-form">
        <div class="cart-drawer-lines">{% render 'cart-lines', context: 'drawer' %}</div>
        <div class="cart-drawer-footer">
          {% render 'cart-summary' %}
          <button class="btn cart-checkout" type="submit" name="checkout">Checkout</button>
          <a class="text-link" href="{{ routes.cart_url }}">View full bag</a>
          {% assign has_samples = false %}{% for item in cart.items %}{% if item.product.id == settings.sample_product.id or item.product.type == 'Samples' %}{% assign has_samples = true %}{% endif %}{% endfor %}
          {% if settings.sample_product != blank and has_samples == false %}<a class="text-link cart-sample" href="{{ settings.sample_product.url }}">Explore samples for your next scent →</a>{% endif %}
        </div>
      </form>
    {% endif %}
  </div>
</dialog>
{% schema %}{"name":"Cart drawer","settings":[]}{% endschema %}
