<section class="page-width page-hero"><div class="eyebrow">Account</div><h1 class="section-title">Hello, {{ customer.first_name | default: customer.name }}.</h1><p><a href="{{ routes.account_logout_url }}">Sign out</a></p></section><section class="page-width section-tight"><h2 class="serif">Orders</h2>{% if customer.orders.size > 0 %}{% for order in customer.orders %}<div class="experience-card" style="margin-bottom:12px"><a href="{{ order.customer_url }}"><strong>{{ order.name }}</strong></a><div>{{ order.created_at | date: '%B %d, %Y' }} · {{ order.total_price | money }}</div></div>{% endfor %}{% else %}<p>No orders yet.</p>{% endif %}<p><a href="{{ routes.account_addresses_url }}">Manage addresses →</a></p></section>{% schema %}{"name":"Customer account","settings":[]}{% endschema %}
