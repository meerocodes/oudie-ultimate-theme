<section class="page-width page-hero"><div class="eyebrow">Account</div><h1 class="section-title">Welcome back.</h1></section><section class="page-width section-tight"><div class="split-copy" style="max-width:620px;border:1px solid var(--line)">{% form 'customer_login' %}{{ form.errors | default_errors }}<div class="field"><label>Email</label><input required type="email" name="customer[email]"></div><div class="field" style="margin-top:12px"><label>Password</label><input required type="password" name="customer[password]"></div><button class="btn" style="margin-top:16px">Sign in</button>{% endform %}<p><a href="{{ routes.account_register_url }}">Create account</a></p></div></section>{% schema %}{"name":"Customer login","settings":[]}{% endschema %}
