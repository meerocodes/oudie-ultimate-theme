<section class="page-width page-hero"><div class="eyebrow">Order</div><h1 class="section-title">{{ order.name }}</h1><p class="section-copy">Placed {{ order.created_at | date: '%B %d, %Y' }}</p></section><section class="page-width section-tight">{% for line_item in order.line_items %}<div class="cart-line"><div></div><div><strong>{{ line_item.title }}</strong><div>Qty {{ line_item.quantity }}</div></div><div>{{ line_item.final_line_price | money }}</div></div>{% endfor %}<div class="cart-total"><span>Total</span><span>{{ order.total_price | money }}</span></div><a href="{{ routes.account_url }}">← Back to account</a></section>{% schema %}{"name":"Customer order","settings":[]}{% endschema %}
