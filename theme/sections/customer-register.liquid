<section class="page-width page-hero"><div class="eyebrow">Account</div><h1 class="section-title">Create your account.</h1></section><section class="page-width section-tight"><div class="split-copy" style="max-width:620px;border:1px solid var(--line)">{% form 'create_customer' %}{{ form.errors | default_errors }}<div class="form-grid"><div class="field"><label>First name</label><input name="customer[first_name]"></div><div class="field"><label>Last name</label><input name="customer[last_name]"></div><div class="field full"><label>Email</label><input required type="email" name="customer[email]"></div><div class="field full"><label>Password</label><input required type="password" name="customer[password]"></div></div><button class="btn" style="margin-top:16px">Create account</button>{% endform %}</div></section>{% schema %}{"name":"Customer register","settings":[]}{% endschema %}
