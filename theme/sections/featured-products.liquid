{% capture cards %}
  {% assign seen_scents = '' %}
  {% for scent in section.settings.scents %}
    {% assign scent_token = scent.system.id | prepend: '|' | append: '|' %}
    {% unless seen_scents contains scent_token %}
      {% render 'scent-card', scent: scent, products: section.settings.products %}
      {% assign seen_scents = seen_scents | append: scent_token %}
    {% endunless %}
  {% endfor %}
{% endcapture %}
{% assign cards = cards | strip %}
{% if cards != blank or request.design_mode %}
  <section class="section signature-scents"><div class="page-width">
    <div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="section-title">{{ section.settings.heading | escape }}</h2></div>
      {% assign discovery_link = section.settings.link | default: pages['our-scents'].url %}
      {% if discovery_link != blank %}<a class="text-link" href="{{ discovery_link }}">{{ 'cards.explore_all' | t }} <span aria-hidden="true">↗</span></a>{% endif %}
    </div>
    {% if cards != blank %}<div class="product-grid">{{ cards }}</div>{% else %}<p class="editor-notice">{{ 'cards.configure' | t }}</p>{% endif %}
  </div></section>
{% endif %}
{% schema %}
{"name":"Signature scents","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The scent wardrobe"},{"type":"text","id":"heading","label":"Heading","default":"Find something personal."},{"type":"metaobject_list","id":"scents","label":"Curated scents","metaobject_type":"oudie_scent","limit":8},{"type":"product_list","id":"products","label":"Fragrance formats","limit":12,"info":"Choose fragrance products to match by canonical scent. Tickets, samples and helper products are excluded."},{"type":"url","id":"link","label":"Explore all link"}],"presets":[{"name":"Signature scents"}]}
{% endschema %}
