{% assign guide = section.settings.blog | default: blogs['oud-guide'] %}
{% if guide.articles.size > 0 %}<section class="page-width section home-guide"><div class="section-heading"><div><div class="eyebrow">Oud Guide</div><h2 class="section-title">{{ section.settings.heading | escape }}</h2></div><a class="text-link" href="{{ guide.url }}">View all guides ↗</a></div><div class="guide-grid">{% for article in guide.articles limit: 3 %}<article><a href="{{ article.url }}">{% if article.image %}{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.image.alt }}{% else %}<div class="guide-cover"><span>OUDIE</span><span>Oud Guide</span></div>{% endif %}<h3 class="serif">{{ article.title | escape }}</h3><p>{{ article.excerpt_or_content | strip_html | truncate: 150 }}</p><span class="text-link">Read the guide ↗</span></a></article>{% endfor %}</div></section>{% endif %}
{% schema %}{"name":"Oud Guide reading","settings":[{"type":"blog","id":"blog","label":"Blog"},{"type":"text","id":"heading","label":"Heading","default":"A little fragrance knowledge."}],"presets":[{"name":"Oud Guide reading"}]}{% endschema %}
