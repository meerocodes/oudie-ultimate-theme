{% liquid
  assign hero_image = section.settings.image
  if hero_image == blank and section.settings.product != blank
    assign hero_image = section.settings.product.featured_image
  endif
  assign mobile_image = section.settings.mobile_image | default: hero_image
  assign shop_link = section.settings.primary_link | default: collections['all-oudie'].url | default: routes.all_products_collection_url
  assign experience_link = section.settings.secondary_link | default: pages['oudie-experiences'].url
%}
<section class="hero{% if hero_image == blank %} hero--text{% endif %}">
  {% if hero_image != blank %}
    <picture class="hero-media">
      {% if mobile_image != blank %}<source media="(max-width: 759px)" srcset="{{ mobile_image | image_url: width: 480 }} 480w, {{ mobile_image | image_url: width: 780 }} 780w, {{ mobile_image | image_url: width: 1100 }} 1100w" sizes="100vw">{% endif %}
      {{ hero_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '780,1100,1600,2200,2400', sizes: '100vw' }}
    </picture>
  {% endif %}
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="page-width hero-content">
    {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h1>{{ section.settings.heading | escape }}</h1>
    {% if section.settings.copy != blank %}<p class="hero-copy">{{ section.settings.copy | escape }}</p>{% endif %}
    <div class="button-row"><a class="btn btn--light" href="{{ shop_link }}">{{ section.settings.primary_label | escape }}</a>{% if experience_link != blank %}<a class="hero-link text-link" href="{{ experience_link }}">{{ section.settings.secondary_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}</div>
  </div>
</section>
{% schema %}
{"name":"Home hero","settings":[{"type":"image_picker","id":"image","label":"Desktop image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"product","id":"product","label":"Fallback product image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Oud & musk · OUDIE"},{"type":"text","id":"heading","label":"Heading","default":"Oud, after dark."},{"type":"textarea","id":"copy","label":"Copy","default":"Discover oud and musk fragrances. Find the scent that stays with you."},{"type":"text","id":"primary_label","label":"Primary button","default":"Shop scents"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary link label","default":"Explore the Oud Bar"},{"type":"url","id":"secondary_link","label":"Secondary link"}],"presets":[{"name":"Home hero"}]}
{% endschema %}
