<section class="section discovery-intro"><div class="page-width home-intro">
  <div><p class="eyebrow">{{ 'homepage.discover' | t }}</p><h2 class="section-title">{{ section.settings.heading | escape }}</h2></div>
  <div><p class="section-copy">{{ section.settings.copy | escape }}</p>{% assign link = section.settings.link | default: pages['our-scents'].url %}{% if link != blank %}<a class="text-link" href="{{ link }}">{{ 'homepage.discovery_link' | t }} <span aria-hidden="true">↗</span></a>{% endif %}</div>
</div></section>
{% schema %}
{"name":"Scent discovery intro","settings":[{"type":"text","id":"heading","label":"Heading","default":"Follow the notes you love."},{"type":"textarea","id":"copy","label":"Copy","default":"Start with a familiar note, meet a new scent, or take your time with samples. There is more than one way to find your OUDIE."},{"type":"url","id":"link","label":"Discovery link"}],"presets":[{"name":"Scent discovery intro"}]}
{% endschema %}
