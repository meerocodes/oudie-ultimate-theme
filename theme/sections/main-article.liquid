<article class="page-width"><header class="page-hero"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a> / <a href="{{ blog.url }}">{{ blog.title | escape }}</a> / <span>{{ article.title | escape }}</span></nav><div class="eyebrow">OUDIE Oud Guide</div><h1 class="section-title">{{ article.title | escape }}</h1><p class="section-copy">{{ article.published_at | date: '%B %d, %Y' }}{% if article.author != blank %} · {{ article.author | escape }}{% endif %}</p></header>{% if article.image %}<div class="experience-image">{{ article.image | image_url: width: 1800 | image_tag: loading: 'eager', alt: article.image.alt }}</div>{% endif %}<div class="rte section-tight article-body">{{ article.content }}</div><aside class="article-related"><h2 class="serif">Continue exploring</h2><p><a class="text-link" href="{{ pages['our-scents'].url }}">Find your OUDIE scent ↗</a></p>{% if settings.sample_product != blank %}<p><a class="text-link" href="{{ settings.sample_product.url }}">Explore fragrance samples ↗</a></p>{% endif %}{% if blog.articles.size > 1 %}<h3>More from {{ blog.title | escape }}</h3><ul>{% assign related_count = 0 %}{% for related in blog.articles %}{% if related.id != article.id and related_count < 3 %}<li><a href="{{ related.url }}">{{ related.title | escape }}</a></li>{% assign related_count = related_count | plus: 1 %}{% endif %}{% endfor %}</ul>{% endif %}</aside></article>
<script type="application/ld+json">{{ article | structured_data }}</script>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ shop.url | json }}},{"@type":"ListItem","position":2,"name":{{ blog.title | json }},"item":{{ blog.url | prepend: shop.url | json }}},{"@type":"ListItem","position":3,"name":{{ article.title | json }},"item":{{ canonical_url | json }}}]}</script>
{% schema %}{"name":"Article","settings":[]}{% endschema %}
