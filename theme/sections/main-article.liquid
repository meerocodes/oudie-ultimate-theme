<article class="page-width"><header class="page-hero"><div class="eyebrow">OUDIE journal</div><h1 class="section-title">{{ article.title }}</h1><p class="section-copy">{{ article.published_at | date: '%B %d, %Y' }}</p></header>{% if article.image %}<div class="split-media" style="min-height:0;margin-bottom:32px">{{ article.image | image_url: width: 1800 | image_tag: loading: 'eager' }}</div>{% endif %}<div class="rte section-tight" style="max-width:820px">{{ article.content }}</div></article>{% schema %}{"name":"Article","settings":[]}{% endschema %}
