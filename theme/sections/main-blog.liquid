<section class="page-width page-hero"><div class="eyebrow">Journal</div><h1 class="section-title">{{ blog.title }}</h1></section><section class="page-width section-tight">{% paginate blog.articles by 12 %}<div class="product-grid">{% for article in blog.articles %}<article class="product-card"><a href="{{ article.url }}"><div class="product-card-media">{% if article.image %}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy' }}{% endif %}</div><div class="product-card-info"><h2 class="product-card-title">{{ article.title }}</h2><p class="product-card-notes">{{ article.excerpt_or_content | strip_html | truncate: 110 }}</p></div></a></article>{% endfor %}</div>{% if paginate.pages > 1 %}<div class="pagination">{{ paginate | default_pagination }}</div>{% endif %}{% endpaginate %}</section>{% schema %}{"name":"Blog","settings":[]}{% endschema %}
