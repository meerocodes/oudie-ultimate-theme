<section class="page-width page-hero"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a> / <span>{{ blog.title | escape }}</span></nav><div class="eyebrow">OUDIE journal</div><h1 class="section-title">{{ blog.title | escape }}</h1></section><section class="page-width section-tight">{% paginate blog.articles by 12 %}<div class="product-grid">{% for article in blog.articles %}<article class="product-card"><a href="{{ article.url }}"><div class="product-card-media">{% if article.image %}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy' }}{% else %}<div class="journal-placeholder">Oud Guide</div>{% endif %}</div><div class="product-card-info"><h2 class="product-card-title">{{ article.title | escape }}</h2><p class="product-card-notes">{{ article.excerpt_or_content | strip_html | truncate: 110 }}</p></div></a></article>{% else %}<p class="empty-state">New fragrance guides are being prepared. <a class="text-link" href="{{ pages['our-scents'].url }}">Explore our scents</a> while you wait.</p>{% endfor %}</div>{% if paginate.pages > 1 %}<div class="pagination">{{ paginate | default_pagination }}</div>{% endif %}{% endpaginate %}</section>{% schema %}{"name":"Blog","settings":[]}{% endschema %}
