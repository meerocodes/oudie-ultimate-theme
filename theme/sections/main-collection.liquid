<section>
  <div class="page-width collection-head">
    <div class="collection-head-row">
      <div><div class="eyebrow">OUDIE collection</div><h1 class="section-title">{{ collection.title }}</h1>{% if collection.description != blank %}<div class="section-copy">{{ collection.description | strip_html | truncate: 240 }}</div>{% endif %}</div>
    </div>
    <div class="collection-toolbar" aria-label="Shop shortcuts">
      <a class="chip" href="/collections/all-oudie">All</a><a class="chip" href="/pages/our-scents">By scent</a><a class="chip" href="/products/sample-pack-1-of-each-scent">Samples</a><a class="chip" href="/pages/oudie-experiences">Experiences</a>
    </div>
  </div>
  <div class="page-width section-tight">
    {% if collection.handle == 'all-oudie' and settings.fragrance_products != blank %}
      {% render 'scent-grid', id: section.id %}
      <h2 class="section-title supporting-title">Samples & more</h2>
      <div class="product-grid">
        {% for product in collection.products %}
          {% assign has_scent = false %}
          {% for v in product.variants %}{% if v.metafields.custom.scent.value != blank or product.metafields.custom.scent.value != blank %}{% assign has_scent = true %}{% endif %}{% endfor %}
          {% unless has_scent or product.type == 'Event Ticket' or product.type == 'Workshops' or product.template_suffix == 'workshop' or product.template_suffix == 'oud-and-stones' %}{% render 'product-card', product: product %}{% endunless %}
        {% endfor %}
      </div>
    {% else %}
    {% paginate collection.products by 24 %}
      {% assign rendered_count = 0 %}
      <div class="product-grid">
        {% for product in collection.products %}
          {% assign event_product = false %}
          {% if product.type == 'Event Ticket' or product.type == 'Workshops' or product.template_suffix == 'workshop' or product.template_suffix == 'oud-and-stones' %}{% assign event_product = true %}{% endif %}
          {% if event_product == false or collection.handle == 'workshops' %}
            {% render 'product-card', product: product %}
            {% assign rendered_count = rendered_count | plus: 1 %}
          {% endif %}
        {% endfor %}
        {% if rendered_count == 0 %}<div class="empty-state">{{ 'cards.no_products' | t }}</div>{% endif %}
      </div>
      {% if paginate.pages > 1 %}<div class="pagination">{{ paginate | default_pagination }}</div>{% endif %}
    {% endpaginate %}
    {% endif %}
  </div>
</section>
{% schema %}{"name":"Main collection","settings":[]}{% endschema %}
