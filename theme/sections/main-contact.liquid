<section class="page-width page-hero"><div class="eyebrow">Contact OUDIE</div><h1 class="section-title">Get in touch.</h1><p class="section-copy">Questions about an order, a scent, or something else? Send the OUDIE team a note.</p></section>
<section class="page-width section-tight"><div class="split-copy" style="max-width:760px;border:1px solid var(--line)">{% form 'contact' %}{% if form.posted_successfully? %}<p><strong>Thank you. Your message has been sent.</strong></p>{% endif %}{{ form.errors | default_errors }}<div class="form-grid"><div class="field"><label>Name</label><input name="contact[name]" value="{{ form.name }}"></div><div class="field"><label>Email</label><input required type="email" name="contact[email]" value="{{ form.email }}"></div><div class="field full"><label>Message</label><textarea required class="textarea" name="contact[body]">{{ form.body }}</textarea></div></div><button class="btn" style="margin-top:16px" type="submit">Send message</button>{% endform %}</div></section>
{% schema %}{"name":"Contact","settings":[]}{% endschema %}
