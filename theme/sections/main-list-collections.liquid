<section class="page-width page-hero"><div class="eyebrow">Shop OUDIE</div><h1 class="section-title">Collections</h1></section><section class="page-width section-tight"><div class="product-grid">{% for collection in collections %}{% if collection.products_count > 0 %}<article class="product-card"><a href="{{ collection.url }}"><div class="product-card-media">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy' }}{% elsif collection.products.first.featured_image %}{{ collection.products.first.featured_image | image_url: width: 900 | image_tag: loading: 'lazy' }}{% endif %}</div><div class="product-card-info"><h2 class="product-card-title">{{ collection.title }}</h2><div class="product-card-price">{{ collection.products_count }} products</div></div></a></article>{% endif %}{% endfor %}</div></section>{% schema %}{"name":"Collection list","settings":[]}{% endschema %}
