{% liquid
  assign variant = product.selected_or_first_available_variant
  assign scent = variant.metafields.custom.scent.value | default: product.metafields.custom.scent.value
  assign primary_image = variant.featured_media.preview_image | default: scent.hero_image.value | default: product.featured_image
  assign primary_alt = primary_image.alt | default: product.title
%}
<section class="page-width section-tight" data-product-root>
  <nav class="product-breadcrumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><a href="{{ pages['our-scents'].url | default: routes.all_products_collection_url }}">Scents</a><span aria-hidden="true">/</span><span aria-current="page">{{ scent.name.value | default: product.title | escape }}</span></nav>
  <div class="product-page">
    <div class="product-heading">
      <div class="eyebrow">{{ scent.line.value | default: 'OUDIE' | escape }}</div>
      <h1 class="product-title">{{ scent.name.value | default: product.title | escape }}</h1>
      <div class="product-subtitle">{{ product.title | escape }}</div>
      {% render 'review-summary', product: product %}
    </div>
    <div class="product-gallery" data-gallery>
      <div class="product-primary-media" data-primary-media>
        {% if primary_image %}{{ primary_image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '360,600,900,1200,1600', sizes: '(min-width: 990px) 50vw, 90vw', alt: primary_alt }}{% else %}<div class="card-placeholder">OUDIE</div>{% endif %}
        {% if primary_image %}<button type="button" class="gallery-zoom" data-gallery-zoom aria-label="Enlarge product image" hidden>Enlarge ↗</button>{% endif %}
      </div>
      {% if product.media.size > 1 %}
        <div class="product-thumbnails" aria-label="Product images">
          {% for media in product.media %}
            {% assign shared_media = true %}{% assign current_scent_media = false %}
            {% for other in product.variants %}{% if other.featured_media.id == media.id %}{% assign shared_media = false %}{% assign other_scent = other.metafields.custom.scent.value | default: product.metafields.custom.scent.value %}{% if other_scent.system.id == scent.system.id or other.id == variant.id %}{% assign current_scent_media = true %}{% endif %}{% endif %}{% endfor %}
            {% if media.media_type == 'image' and shared_media or media.media_type == 'image' and current_scent_media or media.media_type == 'image' and scent == blank %}
              {% assign media_alt = media.alt | default: product.title %}
              <a href="{{ media | image_url: width: 1600 }}" data-gallery-image {% if media.preview_image.id == primary_image.id %}aria-current="true"{% endif %} data-src="{{ media | image_url: width: 1600 }}" data-alt="{{ media.alt | default: product.title | escape }}" aria-label="View image {{ forloop.index }}">{{ media | image_url: width: 120 | image_tag: loading: 'lazy', alt: media_alt }}</a>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
      <dialog class="gallery-dialog" data-gallery-dialog aria-label="Product image viewer"><div class="gallery-dialog-controls"><button type="button" class="btn btn--ghost" data-gallery-previous aria-label="Previous image">←</button><span data-gallery-count aria-live="polite"></span><button type="button" class="btn btn--ghost" data-gallery-next aria-label="Next image">→</button><button type="button" class="btn btn--ghost" data-gallery-close aria-label="Close image viewer">Close</button></div><img data-gallery-full width="{{ primary_image.width | default: 1600 }}" height="{{ primary_image.height | default: 1600 }}" alt=""></dialog>
    </div>
    <div class="product-details">
      <div class="product-price" data-product-price>{{ variant.price | money }}</div>
      {% if scent != blank and settings.fragrance_products != blank %}
        <div class="format-field">
          <span class="option-label" id="FormatLabel-{{ section.id }}">Format</span>
          <div class="format-choices" aria-labelledby="FormatLabel-{{ section.id }}">{% render 'scent-card', mode: 'links', scent: scent, products: settings.fragrance_products, current_product: product, current_variant: variant %}</div>
          <div class="format-mobile" hidden><label class="visually-hidden" for="Format-{{ section.id }}">Format</label><select class="select" id="Format-{{ section.id }}" data-format-select>{% render 'scent-card', mode: 'options', scent: scent, products: settings.fragrance_products, current_product: product, current_variant: variant %}</select></div>
        </div>
      {% endif %}
      {% form 'product', product %}
        {% if product.variants.size > 1 %}
          <div class="variant-field" data-native-options>
            <label for="VariantSelect-{{ section.id }}">Scent / product option</label>
            <select class="select" id="VariantSelect-{{ section.id }}" name="id" data-variant-select data-option-names="{{ product.options | json | escape }}">
              {% for v in product.variants %}
                {% assign v_scent = v.metafields.custom.scent.value | default: product.metafields.custom.scent.value %}
                <option value="{{ v.id }}" data-url="{{ v.url }}" data-price="{{ v.price | money | escape }}" data-available="{{ v.available }}" data-options="{{ v.options | json | escape }}" data-scent="{{ v_scent.system.id | escape }}" data-scent-name="{{ v_scent.name.value | escape }}" {% if v.id == variant.id %}selected{% endif %}>{{ v.title | escape }} — {{ v.price | money }}{% unless v.available %} — Sold out{% endunless %}</option>
              {% endfor %}
            </select>
          </div>
          <div data-product-options></div>
        {% else %}<input type="hidden" name="id" value="{{ variant.id }}">{% endif %}
        <input type="hidden" name="quantity" value="1">
        <p class="product-error" data-product-error role="alert" hidden></p>
        <button class="btn atc" type="submit" data-atc {% unless variant.available %}disabled{% endunless %}>{% if variant.available %}Add to bag{% else %}Sold out{% endif %}</button>
        {{ form | payment_button }}
      {% endform %}
      <p class="purchase-shipping">{% render 'shipping-policy' %}</p>
      {% if settings.sample_product != blank and product.id != settings.sample_product.id and scent != blank %}<a class="text-link sample-link" href="{{ settings.sample_product.url }}">Not sure yet? Explore samples →</a>{% endif %}
      {% if scent %}
        {% unless scent.system.handle == 'oudie-bella' %}
          <div class="note-pyramid">
            {% if scent.top_notes.value != blank %}<div class="note-row"><div class="note-label">Top</div><div>{{ scent.top_notes.value | join: ', ' | escape }}</div></div>{% endif %}
            {% if scent.heart_notes.value != blank %}<div class="note-row"><div class="note-label">Heart</div><div>{{ scent.heart_notes.value | join: ', ' | escape }}</div></div>{% endif %}
            {% if scent.base_notes.value != blank %}<div class="note-row"><div class="note-label">Base</div><div>{{ scent.base_notes.value | join: ', ' | escape }}</div></div>{% endif %}
          </div>
        {% endunless %}
      {% elsif variant.metafields.custom.scent_notes.value != blank %}<div class="rte legacy-notes">{{ variant.metafields.custom.scent_notes.value | escape }}</div>{% endif %}
      <div class="accordion">
        <details><summary>About this product</summary><div class="rte">{{ product.description }}</div></details>
        <details><summary>Shipping</summary><div class="rte"><p>{% render 'shipping-policy' %}</p></div></details>
      </div>
      {% for block in section.blocks %}{% if block.type == '@app' %}<div {{ block.shopify_attributes }}>{% render block %}</div>{% endif %}{% endfor %}
    </div>
  </div>
</section>
{% render 'product-reviews', product: product %}
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}{"name":"Main product","settings":[],"blocks":[{"type":"@app"}]}{% endschema %}
