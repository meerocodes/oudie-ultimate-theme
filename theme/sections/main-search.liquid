<section class="page-width page-hero"><div class="eyebrow">Search</div><h1 class="section-title">Search OUDIE</h1></section>
<section class="page-width section-tight">
  <form class="search-form" action="{{ routes.search_url }}" role="search"><label class="visually-hidden" for="Search-{{ section.id }}">Search products and pages</label><input id="Search-{{ section.id }}" class="select" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products and pages"><button class="btn">Search</button></form>
  {% if search.performed %}
    <div class="search-scents"><h2 class="section-title">Scents</h2>{% render 'scent-grid', id: section.id, query: search.terms %}</div>
    {% paginate search.results by 24 %}
      <div class="search-other"><h2 class="section-title">Products & pages</h2><div class="product-grid">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            {% unless item.type == 'Event Ticket' or item.type == 'Workshops' or item.template_suffix == 'workshop' or item.template_suffix == 'oud-and-stones' %}{% render 'product-card', product: item %}{% endunless %}
          {% else %}<article><h3><a class="text-link" href="{{ item.url }}">{{ item.title | escape }}</a></h3></article>{% endif %}
        {% endfor %}
      </div></div>
      {% if paginate.pages > 1 %}<div class="pagination">{{ paginate | default_pagination }}</div>{% endif %}
    {% endpaginate %}
  {% endif %}
</section>
{% schema %}{"name":"Main search","settings":[]}{% endschema %}
