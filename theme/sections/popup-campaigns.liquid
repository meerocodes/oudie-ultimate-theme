<div data-popup-campaigns data-theme="{{ section.id }}" data-section="{{ section.id }}" data-one-per-session="{{ section.settings.one_per_session }}" data-suppress-legacy="{{ section.settings.suppress_legacy }}" data-editor="{{ request.design_mode }}" data-customer="{% if customer %}true{% else %}false{% endif %}" data-subscriber="{% if customer.accepts_marketing %}true{% else %}false{% endif %}">
{% for block in section.blocks %}{% assign popup_id = 'Popup-' | append: section.id | append: '-' | append: block.id %}
<div data-popup-campaign data-campaign="{{ block.id }}" {{ block.shopify_attributes }}><script type="application/json" data-popup-config>{{ block.settings | json }}</script><p class="popup-editor-warning" data-popup-warning hidden></p>
<dialog class="oudie-popup{% if block.settings.image != blank %} oudie-popup--image{% endif %}" id="{{ popup_id }}" data-popup-dialog aria-labelledby="{{ popup_id }}-Title"><button type="button" class="popup-close" data-popup-close aria-label="Close popup">×</button>{% if block.settings.image != blank %}<div class="popup-image">{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: block.settings.image.alt }}</div>{% endif %}<div class="popup-copy"><div class="eyebrow">OUDIE</div><h2 class="serif" id="{{ popup_id }}-Title">{{ block.settings.heading | escape }}</h2><p>{{ block.settings.body | escape }}</p>
{% if block.settings.kind == 'signup' %}{% assign signup_id = popup_id | append: '-Signup' %}{% form 'customer', id: signup_id, class: 'popup-signup' %}<input type="hidden" name="contact[tags]" value="newsletter,oudie-native-popup"><input type="hidden" name="return_to" value="{{ request.path }}#{{ popup_id }}">
{% if form.posted_successfully? %}<p class="form-success" data-popup-success role="status">Thank you. You’re on the OUDIE list.</p>{% else %}{% if form.errors %}<div class="form-errors" data-popup-errors role="alert">{{ form.errors | default_errors }}</div>{% endif %}<label for="{{ popup_id }}-Email">Email address</label><input id="{{ popup_id }}-Email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email | escape }}"><label class="popup-consent"><input type="checkbox" name="contact[accepts_marketing]" value="true" required> Email me OUDIE scent news and offers.</label><button class="btn" type="submit">Join the list</button>{% if shop.privacy_policy != blank %}<a class="text-link" href="{{ shop.privacy_policy.url }}">Privacy policy</a>{% endif %}{% endif %}{% endform %}
{% else %}{% if block.settings.discount_code != blank %}<div class="popup-code"><span data-popup-code>{{ block.settings.discount_code | escape }}</span><button type="button" class="text-link" data-popup-copy-code hidden>Copy code</button><span data-popup-code-status role="status"></span></div>{% endif %}{% if block.settings.cta_url != blank %}<a class="btn" href="{{ block.settings.cta_url }}">{{ block.settings.cta_label | escape }}</a>{% endif %}{% endif %}</div></dialog></div>
{% endfor %}</div>
<script src="{{ 'oudie-popups.js' | asset_url }}" defer="defer"></script>
{% schema %}{"name":"Native popup campaigns","max_blocks":2,"settings":[{"type":"checkbox","id":"suppress_legacy","label":"Suppress legacy Pop Convert in this theme","default":true},{"type":"checkbox","id":"one_per_session","label":"Maximum one campaign per session","default":true}],"blocks":[{"type":"campaign","name":"Popup campaign","settings":[{"type":"checkbox","id":"enabled","label":"Enable campaign","default":false},{"type":"select","id":"kind","label":"Content type","default":"signup","options":[{"value":"signup","label":"Email signup"},{"value":"promotion","label":"Promotion / announcement"}]},{"type":"text","id":"heading","label":"Heading","default":"Find your next OUDIE."},{"type":"textarea","id":"body","label":"Message","default":"Receive scent news, new releases and OUDIE experiences by email."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"Button label","default":"Discover OUDIE"},{"type":"url","id":"cta_url","label":"Button link"},{"type":"text","id":"discount_code","label":"Optional existing discount code","info":"Display only. This does not create a discount."},{"type":"text","id":"timezone","label":"Schedule timezone","default":"America/Toronto","info":"IANA timezone, for example America/Toronto. Daylight saving is handled automatically."},{"type":"text","id":"start_date","label":"Campaign start date","info":"YYYY-MM-DD; blank means no start date."},{"type":"text","id":"start_time","label":"Start time","default":"00:00","info":"HH:MM in the schedule timezone."},{"type":"text","id":"end_date","label":"Campaign end date","info":"YYYY-MM-DD; blank means no end date. End is exclusive."},{"type":"text","id":"end_time","label":"End time","default":"00:00","info":"HH:MM in the schedule timezone."},{"type":"text","id":"daily_start","label":"Optional daily opening time","info":"HH:MM; leave both daily times blank for all day."},{"type":"text","id":"daily_end","label":"Optional daily closing time","info":"HH:MM. Overnight windows are supported."},{"type":"checkbox","id":"mon","label":"Show on Monday","default":true},{"type":"checkbox","id":"tue","label":"Show on Tuesday","default":true},{"type":"checkbox","id":"wed","label":"Show on Wednesday","default":true},{"type":"checkbox","id":"thu","label":"Show on Thursday","default":true},{"type":"checkbox","id":"fri","label":"Show on Friday","default":true},{"type":"checkbox","id":"sat","label":"Show on Saturday","default":true},{"type":"checkbox","id":"sun","label":"Show on Sunday","default":true},{"type":"select","id":"trigger","label":"Trigger","default":"delay","options":[{"value":"delay","label":"Time delay"},{"value":"scroll","label":"Scroll depth"},{"value":"exit","label":"Desktop exit intent"}]},{"type":"range","id":"delay","label":"Delay / earliest display","min":0,"max":120,"step":5,"unit":"s","default":20},{"type":"range","id":"scroll","label":"Scroll depth","min":10,"max":100,"step":10,"unit":"%","default":50},{"type":"range","id":"pageviews","label":"Minimum session page views","min":1,"max":10,"step":1,"default":2},{"type":"select","id":"devices","label":"Devices","default":"all","options":[{"value":"all","label":"All devices"},{"value":"desktop","label":"Desktop only"},{"value":"mobile","label":"Mobile only"}]},{"type":"select","id":"audience","label":"Audience","default":"all","options":[{"value":"all","label":"All visitors"},{"value":"new","label":"New visitors"},{"value":"returning","label":"Returning visitors"},{"value":"guest","label":"Logged-out visitors"}]},{"type":"textarea","id":"include_paths","label":"Only these page paths","info":"One path per line; * matches the end of a path. Blank means all pages."},{"type":"textarea","id":"exclude_paths","label":"Exclude page paths","default":"/cart\n/checkout*\n/challenge*","info":"One path per line; * matches the end of a path."},{"type":"select","id":"frequency","label":"Campaign frequency","default":"session","options":[{"value":"session","label":"Once per session"},{"value":"day","label":"Once per day"},{"value":"cooldown","label":"Dismissal cooldown only"}]},{"type":"range","id":"cooldown","label":"Dismissal cooldown","min":0,"max":30,"step":1,"unit":"d","default":7},{"type":"range","id":"priority","label":"Priority (lower runs first)","min":1,"max":10,"step":1,"default":1},{"type":"text","id":"revision","label":"Campaign version","default":"1","info":"Change this value to reset this campaign\u2019s display and dismissal history."}]}]}{% endschema %}
