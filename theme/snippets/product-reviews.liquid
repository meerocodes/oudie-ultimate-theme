{% doc %}
  Supplies the Judge.me review widget mount; its app embed loads the widget.
  @param {product} product - Native Shopify product.
{% enddoc %}
<section class="page-width section product-reviews" aria-label="{{ 'commerce.reviews' | t }}">
  <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-product-title="{{ product.title | escape }}" data-id="{{ product.id }}" data-product-id="{{ product.id }}" data-widget="review" data-auto-install="false" data-entry-point="review_widget.js" data-entry-key="review-widget/main.js">
    {% if product.metafields.judgeme.widget.size > 20 %}<div class="jdgm-legacy-widget-content">{{ product.metafields.judgeme.widget }}</div>{% endif %}
  </div>
</section>
