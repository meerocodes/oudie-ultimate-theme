{% doc %}
  Shared canonical scent resolver. Modes: card (default), links, options.
  @param {metaobject} scent
  @param {product[]} [preferred_products] - Category products for initial selection.
  @param {product[]} products
  @param {string} [query]
  @param {string} [mode]
  @param {product} [current_product]
  @param {variant} [current_variant]
{% enddoc %}
{% liquid
  assign preferred_product = nil
  assign preferred_variant = nil
  assign best_rank = 99
  assign core_choices = ''
  assign accessory_choices = ''
  assign formats = ''
  assign allowed_types = 'Extrait de Parfum|Oil Blends|Mists|Car Diffusers|Car Fresheners|Beard Care|Bakhoor' | split: '|'
%}
{% capture destinations %}
  {% for format_product in products %}
    {% if allowed_types contains format_product.type %}
      {% unless format_product.template_suffix == 'workshop' or format_product.template_suffix == 'oud-and-stones' %}
        {% liquid
          assign match = nil
          assign sold_match = nil
          assign product_scent = format_product.metafields.custom.scent.value
          for candidate in format_product.variants
            assign candidate_scent = candidate.metafields.custom.scent.value | default: product_scent
            if candidate_scent != blank and candidate_scent.system.id == scent.system.id
              if sold_match == nil
                assign sold_match = candidate
              endif
              if candidate.available and match == nil
                assign match = candidate
              endif
            endif
          endfor
          assign match = match | default: sold_match
          if current_product.id == format_product.id and current_variant != blank
            assign match = current_variant
          endif
          assign rank = 3
          case format_product.type
            when 'Extrait de Parfum'
              assign rank = 0
            when 'Oil Blends'
              assign rank = 1
            when 'Mists'
              assign rank = 2
          endcase
          assign is_preferred = true
          if preferred_products != blank
            assign is_preferred = false
            for preferred in preferred_products
              if preferred.id == format_product.id
                assign is_preferred = true
              endif
            endfor
            unless is_preferred
              assign rank = rank | plus: 20
            endunless
          endif
          unless match.available
            assign rank = rank | plus: 10
          endunless
        %}
        {% if match != nil %}
          {% capture label %}{% render 'format-label', product: format_product %}{% endcapture %}
          {% assign label = label | strip %}
          {% if rank < best_rank %}{% assign best_rank = rank %}{% assign preferred_product = format_product %}{% assign preferred_variant = match %}{% endif %}
          {% if match.available %}{% assign token = label | prepend: '|' | append: '|' %}{% unless formats contains token %}{% assign formats = formats | append: token %}{% endunless %}{% endif %}
          {% if mode == 'links' %}
            <a class="format-choice{% if current_product.id == format_product.id %} is-active{% endif %}" href="{{ match.url }}" {% if current_product.id == format_product.id %}aria-current="true"{% endif %}>{{ label }}{% unless match.available %}<span>Sold out</span>{% endunless %}</a>
          {% elsif mode == 'options' %}
            <option value="{{ match.url }}" {% if current_product.id == format_product.id %}selected{% endif %}>{{ label }} — {{ match.price | money }}{% unless match.available %} — Sold out{% endunless %}</option>
          {% else %}
            {% capture choice %}            <a class="card-format" href="{{ match.url }}" data-format-destination data-eligible="{{ is_preferred }}" data-format="{{ format_product.type | escape }}" data-url="{{ match.url }}" data-label="{{ label | escape }}" data-price="{{ match.price | money | escape }}" data-available="{{ match.available }}" data-image="{% if match.featured_media.preview_image %}{{ match.featured_media.preview_image | image_url: width: 700 }}{% elsif format_product.featured_image %}{{ format_product.featured_image | image_url: width: 700 }}{% endif %}"> {{ label }}{% unless match.available %}<span class="format-stock">Sold out</span>{% endunless %}</a>{% endcapture %}
            {% if format_product.type == 'Extrait de Parfum' or format_product.type == 'Oil Blends' or format_product.type == 'Mists' %}{% assign core_choices = core_choices | append: choice %}{% else %}{% assign accessory_choices = accessory_choices | append: choice %}{% endif %}
          {% endif %}
        {% endif %}
      {% endunless %}
    {% endif %}
  {% endfor %}
{% endcapture %}
{% if mode == 'links' or mode == 'options' %}
  {{ destinations }}
{% elsif preferred_variant != nil %}
  {% capture labels %}{% assign separator = '' %}{% assign format_labels = formats | split: '|' %}{% for label in format_labels %}{% if label != blank %}{{ separator }}{{ label }}{% assign separator = ' · ' %}{% endif %}{% endfor %}{% endcapture %}
  {% capture price_label %}{% render 'format-label', product: preferred_product %}{% endcapture %}
  {% capture search_text %}{{ scent.name.value }} {{ scent.legacy_names.value | join: ' ' }} {% unless scent.system.handle == 'oudie-bella' %}{{ scent.top_notes.value | join: ' ' }} {{ scent.heart_notes.value | join: ' ' }} {{ scent.base_notes.value | join: ' ' }}{% endunless %} {{ labels | strip }}{% endcapture %}
  {% assign search_text = search_text | downcase %}
  {% assign search_matches = true %}{% assign query_words = query | downcase | split: ' ' %}{% for word in query_words %}{% unless search_text contains word %}{% assign search_matches = false %}{% endunless %}{% endfor %}
  <div {% unless search_matches %}hidden{% endunless %} data-scent-result data-name="{{ scent.name.value | escape }}" data-classification="{{ scent.classification.value | join: '|' | downcase | escape }}" data-search="{{ scent.name.value | downcase | escape }} {{ scent.legacy_names.value | join: ' ' | downcase | escape }} {% unless scent.system.handle == 'oudie-bella' %}{{ scent.top_notes.value | join: ' ' | downcase | escape }} {{ scent.heart_notes.value | join: ' ' | downcase | escape }} {{ scent.base_notes.value | join: ' ' | downcase | escape }}{% endunless %} {{ labels | strip | downcase | escape }}">
    {% render 'product-card', product: preferred_product, variant: preferred_variant, scent: scent, card_price: preferred_variant.price, price_label: price_label, scent_card: true, core_choices: core_choices, accessory_choices: accessory_choices %}
  </div>
{% endif %}
