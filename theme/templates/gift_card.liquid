<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">{{ content_for_header }}{{ 'oudie.css' | asset_url | stylesheet_tag }}</head><body><main class="page-width empty-state"><div class="footer-title" style="color:var(--ink)">OUDIE</div><div class="eyebrow" style="margin-top:20px">Gift card</div><h1 class="section-title" style="font-size:clamp(3rem,8vw,6rem)">{{ gift_card.balance | money }}</h1><p>Use this code at checkout:</p><div class="experience-card" style="display:inline-block;font-size:1.2rem;letter-spacing:.08em">{{ gift_card.code | format_code }}</div><a class="btn" href="{{ shop.url }}">Shop OUDIE</a></main></body></html>